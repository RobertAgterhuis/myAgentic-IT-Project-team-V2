{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "verifier-result.schema.json",
  "title": "VerifierResult",
  "description": "Output of a verifier pass run against a high-risk deliverable. Implements PATTERNS E3.2.",
  "type": "object",
  "required": ["id", "deliverableSource", "agentId", "riskCategory", "verdict", "verifiedAt"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique verifier run ID."
    },
    "deliverableSource": {
      "type": "string",
      "description": "Path to the deliverable file that was verified."
    },
    "agentId": {
      "type": "string",
      "description": "ID of the agent that produced the deliverable."
    },
    "riskCategory": {
      "type": "string",
      "enum": ["architecture", "security", "synthesis", "legal", "financial", "data-model"],
      "description": "Risk category that triggered the verifier pass."
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "pass-with-warnings", "fail"],
      "description": "Overall verification verdict."
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Normalized verification score (1 = fully verified)."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "severity", "description"],
        "additionalProperties": false,
        "properties": {
          "ruleId": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "description": { "type": "string" },
          "lineReference": { "type": "string" },
          "suggestedFix": { "type": "string" }
        }
      }
    },
    "revisionsRequested": {
      "type": "integer",
      "minimum": 0,
      "description": "How many revision requests were raised."
    },
    "revisionsApplied": {
      "type": "integer",
      "minimum": 0
    },
    "selfRevisionApplied": {
      "type": "boolean",
      "description": "Whether a self-revision pass was applied before final handoff."
    },
    "selfRevisionSummary": {
      "type": "string",
      "description": "Summary of changes made during self-revision."
    }
  }
}
