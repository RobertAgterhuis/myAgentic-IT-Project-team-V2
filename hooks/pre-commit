#!/bin/sh
# Pre-commit hook: Block direct commits to main branch
# Guardrail G-GLOB-60 enforcement (local layer)

branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch" = "main" ]; then
  echo ""
  echo "=========================================================="
  echo "  ERROR: Direct commits to 'main' are BLOCKED."
  echo ""
  echo "  Create a feature branch first:"
  echo "    git checkout -b sprint/SP-N/STORY-ID"
  echo ""
  echo "  Then commit, push, and create a Pull Request."
  echo "  Guardrail: G-GLOB-60"
  echo "=========================================================="
  echo ""
  exit 1
fi
