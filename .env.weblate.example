# Weblate Trial — Environment Variables
#
# Copy this file to .env.weblate and fill in the values.
# NEVER commit .env.weblate to version control.
#
# Usage: docker compose -f infra/docker-compose.weblate.yml --env-file .env.weblate up -d
#    or: docker compose -f infra/docker-compose.dev.yml --env-file .env.weblate up -d

# --- REQUIRED ---
# Admin password for Weblate web UI (min 10 characters)
WEBLATE_ADMIN_PASSWORD=changeme-min-10-chars

# PostgreSQL password (min 16 characters recommended)
WEBLATE_DB_PASSWORD=changeme-use-strong-password

# --- OPTIONAL ---
# Admin email address
WEBLATE_ADMIN_EMAIL=admin@localhost

# Host port for Weblate UI (default: 8081 to avoid conflict with webapp on 8080)
WEBLATE_PORT=8081
