{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myagentic-it.local/schema/agent-canonical.schema.json",
  "title": "Canonical Agent Definition Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "generatedAt", "toolCatalog", "agents"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "toolCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tool\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "phase",
          "skillFiles",
          "tools",
          "guardrails",
          "contracts",
          "dependencies",
          "platformBindings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "ORCHESTRATION",
              "ONBOARDING",
              "PHASE_1",
              "PHASE_2",
              "PHASE_3",
              "PHASE_4",
              "CRITIC_RISK",
              "SYNTHESIS",
              "PHASE_5",
              "REEVALUATE",
              "FEATURE",
              "QUESTIONNAIRE",
              "SCOPE_CHANGE",
              "ON_DEMAND"
            ]
          },
          "skillFiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\.github\\/skills\\/.+\\.md$"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^tool\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            }
          },
          "guardrails": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.github\\/docs\\/guardrails\\/.+\\.md$"
            }
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.github\\/docs\\/contracts\\/.+\\.md$"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            }
          },
          "platformBindings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["copilot", "claude", "openai"],
            "properties": {
              "copilot": { "$ref": "#/$defs/platformBinding" },
              "claude": { "$ref": "#/$defs/platformBinding" },
              "openai": { "$ref": "#/$defs/platformBinding" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "platformBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
