# .env.example — Template for docker-compose.dev.yml
# Copy to .env and fill in the values before running:
#   docker compose -f infra/docker-compose.dev.yml up --build

# ── GitHub OAuth provider ──────────────────────────────────────────────────────
# Register an OAuth app at https://github.com/settings/developers.
# Authorization callback URL must be: <AUTH_CALLBACK_URL>/api/auth/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Microsoft Entra ID (Azure AD) OIDC provider ───────────────────────────────
# Register an app in the Azure portal: https://portal.azure.com
# The provider is disabled when ENTRA_CLIENT_ID is not set — no startup crash.
#
# ENTRA_CLIENT_ID      — Application (client) ID of the app registration
# ENTRA_TENANT_ID      — Directory (tenant) ID; use "common" for multi-tenant
# ENTRA_CLIENT_SECRET  — Client secret created under "Certificates & secrets"
# ENTRA_REDIRECT_URI   — Callback URL registered in the app; must match exactly.
#                        Defaults to <AUTH_CALLBACK_URL>/api/auth/entra/callback
# ENTRA_ADMIN_GROUP_ID — Optional comma-separated Entra group IDs mapped to
#                        platform admin role during Entra login/link callbacks

ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_ADMIN_GROUP_ID=

# ── Auth / session settings ────────────────────────────────────────────────────
# AUTH_CALLBACK_URL    — Public base URL used to derive callback URLs.
#                        Example: https://myapp.example.com
# AUTH_STATE_SECRET    — HMAC secret for OAuth state signing (32+ random bytes).
#                        Auto-generated at startup when not set.
# AUTH_SECURE_COOKIES  — Set to "true" in production (requires HTTPS).

AUTH_CALLBACK_URL=http://localhost:3000
AUTH_STATE_SECRET=
AUTH_SECURE_COOKIES=false

# ── API rate limiting ─────────────────────────────────────────────────────────
# RATE_LIMIT_MAX        — Maximum API requests per IP within the time window.
# RATE_LIMIT_WINDOW_MS  — Time window size in milliseconds.
# Defaults in code are RATE_LIMIT_MAX=30 and RATE_LIMIT_WINDOW_MS=60000.

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ── SQLite concurrency strategy ───────────────────────────────────────────────
# SQLITE_JOURNAL_MODE     — `WAL` for the default single-connection model; `DELETE` only for compatibility fallback.
# SQLITE_SYNCHRONOUS      — `NORMAL` (default) or `FULL` durability mode.
# SQLITE_BUSY_TIMEOUT_MS  — Wait window for transient write contention before failing.

SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_BUSY_TIMEOUT_MS=5000

# ── RAG freshness indexing ────────────────────────────────────────────────────
# RAG_FRESHNESS_HEALTH_INTERVAL_MS — Safety-net periodic freshness pass interval.
# RAG_WATCH_ENABLED                — Enable near-realtime file watcher triggers.
# RAG_WATCH_DEBOUNCE_MS            — Debounce window for watcher-triggered reindex.
# RAG_VECTOR_STORE_STRATEGY        — `single-table` or `writer-sharded` for multi-node LanceDB writes.
# RAG_VECTOR_WRITER_ID             — Stable writer shard id when using `writer-sharded`.

# ── Semantic memory sweeper ───────────────────────────────────────────────────
# SEMANTIC_MEMORY_SWEEPER_INTERVAL_MS — Background TTL sweep interval (ms).
# SEMANTIC_MEMORY_SWEEPER_ENABLED     — Toggle periodic sweep (true/false).

RAG_FRESHNESS_HEALTH_INTERVAL_MS=120000
RAG_WATCH_ENABLED=true
RAG_WATCH_DEBOUNCE_MS=5000
RAG_VECTOR_STORE_STRATEGY=single-table
RAG_VECTOR_WRITER_ID=
SEMANTIC_MEMORY_SWEEPER_INTERVAL_MS=300000
SEMANTIC_MEMORY_SWEEPER_ENABLED=true

# Matomo (Analytics) — required for matomo + matomo-db services

MATOMO_DB_PASSWORD=changeme
MATOMO_DB_ROOT_PASSWORD=changeme
MATOMO_PORT=8080

# Weblate passwords are in .env.weblate (see .env.weblate.example)
