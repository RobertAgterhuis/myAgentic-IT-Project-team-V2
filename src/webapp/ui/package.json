{
  "name": "@agentic-sdlc/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:budget": "node ../../scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:monaco-governance": "npm run test:monaco-conformance && npm run test:monaco-contrast",
    "test:monaco-conformance": "vitest run src/lib/editor/monaco-pack-conformance.test.ts --project unit",
    "test:monaco-contrast": "vitest run src/lib/editor/monaco-contrast-regression.test.ts --project unit",
    "test:dense-surface-contrast": "vitest run src/foundations/dense-surface-contrast-regression.test.ts --project unit",
    "test:storybook-governance": "vitest run src/foundations/storybook-governance.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "^5.4.1",
    "msw": "^2.12.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "web-vitals": "^4.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^9.22.0",
    "@storybook/addon-a11y": "^10.2.18",
    "@storybook/addon-docs": "^10.2.18",
    "@storybook/addon-vitest": "^10.2.18",
    "@storybook/react-vite": "^10.2.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^10.2.18",
    "globals": "^16.0.0",
    "jsdom": "^28.1.0",
    "msw-storybook-addon": "^2.0.6",
    "playwright": "^1.58.2",
    "storybook": "^10.2.18",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook\\public"
    ]
  }
}
