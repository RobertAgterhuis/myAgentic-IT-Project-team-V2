{
  "name": "myagentic-it-project-team-v2",
  "version": "0.4.0-rc.1",
  "description": "Agentic SDLC Platform - Multi-agent software development system",
  "main": ".github/webapp/server.js",
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:integration": "jest --testMatch='**/*.integration.test.js' --passWithNoTests",
    "test:smoke": "jest --testMatch='**/*.smoke.test.js' --passWithNoTests",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.ts,.jsx,.tsx --fix",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,jsx,tsx,json,md,yml,yaml}\"",
    "build": "echo 'No build step required — server runs native Node.js'",
    "start": "node .github/webapp/server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RobertAgterhuis/myAgentic-IT-Project-team-V2.git"
  },
  "keywords": [
    "agentic",
    "sdlc",
    "multi-agent",
    "ai",
    "automation"
  ],
  "author": "Robert Agterhuis",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/*.config.js",
      "!**/*.test.{js,ts}",
      "!**/*.spec.{js,ts}",
      "!.github/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.{js,ts}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.github/"
    ]
  }
}
