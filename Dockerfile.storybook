# Dockerfile.storybook — Serves the design system separately from the main webapp
# Build: docker build -f Dockerfile.storybook -t agentic-sdlc-storybook .
# Run:   docker run -p 8080:80 agentic-sdlc-storybook

FROM node:20-alpine AS builder
WORKDIR /app

# Install UI workspace deps
COPY src/webapp/ui/package.json src/webapp/ui/package-lock.json ./
RUN npm ci --ignore-scripts

# Copy source and build tokens + storybook
COPY docs/brand/design-tokens.json /tokens/design-tokens.json
COPY scripts/build-tokens.mjs /scripts/build-tokens.mjs
COPY src/webapp/ui/ ./

# Generate tokens CSS from canonical source
RUN node /scripts/build-tokens.mjs || true

RUN npx storybook build -o storybook-static

# --- Serve via lightweight nginx ---
FROM nginx:stable-alpine
COPY --from=builder /app/storybook-static /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
