{
  "schemaVersion": "1.1.0",
  "name": "sdlc",
  "version": "1.1.0",
  "displayName": "Software Development Lifecycle",
  "description": "End-to-end new software solution creation through a structured multi-agent process across four phases: Requirements & Strategy, Architecture & Design, Experience Design, and Brand & Growth.",
  "flowsFile": "flows.yaml",
  "agentsDir": "agents",
  "contractsDir": "contracts",
  "guardrailsDir": "guardrails",
  "playbooksDir": "playbooks",
  "decisionsDir": "decisions",
  "decisionIndexSeed": "decisions/_index-seed.md",
  "artifactNamespaces": {
    "business_docs": "BusinessDocs"
  },
  "editorProviders": {
    "monaco": {
      "providers": [
        {
          "id": "sdlc-hover-guardrail",
          "kind": "hover",
          "language": "markdown",
          "label": "Guardrail hint",
          "match": {
            "contains": ["UNCERTAIN:", "INSUFFICIENT_DATA:"]
          },
          "markdown": "**Governance note**\\n\\nDocument unresolved uncertainty and link traceable evidence before handoff."
        },
        {
          "id": "sdlc-completion-tags",
          "kind": "completion",
          "language": "markdown",
          "triggerCharacters": ["#", "U"],
          "items": [
            {
              "label": "UNCERTAIN:",
              "insertText": "UNCERTAIN: ",
              "detail": "Mark statements requiring confirmation",
              "kind": "keyword"
            },
            {
              "label": "INSUFFICIENT_DATA:",
              "insertText": "INSUFFICIENT_DATA: ",
              "detail": "Mark missing required data",
              "kind": "keyword"
            }
          ]
        },
        {
          "id": "sdlc-codelens-checklist",
          "kind": "codelens",
          "language": "markdown",
          "lenses": [
            {
              "lineNumber": 1,
              "title": "Run handoff checklist"
            }
          ]
        }
      ]
    }
  },
  "editorSchemas": {
    "monaco": {
      "bindings": [
        {
          "id": "sdlc-contract-json",
          "language": "json",
          "schemaUri": "https://agentic.dev/schemas/contracts/output-contract.schema.json",
          "modelLocator": {
            "namespace": "repo",
            "objectId": "contract-output-json",
            "path": "templates/sdlc/contracts/output-contract.json",
            "language": "json"
          },
          "required": true
        },
        {
          "id": "sdlc-policy-yaml",
          "language": "yaml",
          "schemaUri": "https://agentic.dev/schemas/policy/policy-pack.schema.json",
          "modelLocator": {
            "namespace": "repo",
            "objectId": "policy-pack-yaml",
            "path": "templates/sdlc/guardrails/policy-pack.yaml",
            "language": "yaml"
          },
          "required": false
        }
      ]
    }
  },
