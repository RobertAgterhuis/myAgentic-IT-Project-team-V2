{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myagentic-it-project/schema/phase-exit-criteria.schema.json",
  "title": "Phase Exit Criteria",
  "description": "Machine-checkable gate criteria used to approve or block phase transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "criteria"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gate", "appliesTo", "title", "description", "blocking", "evaluation"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(B1-GATE|B1-SPR)-[0-9]{3}$"
          },
          "gate": {
            "type": "string",
            "enum": ["critic", "sprint"]
          },
          "appliesTo": {
            "type": "string",
            "enum": ["CRITIC_1", "CRITIC_2", "CRITIC_3", "CRITIC_4", "SPRINT_GATE"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "evaluation": {
            "type": "string",
            "minLength": 1
          },
          "sourceRules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          }
        }
      }
    }
  }
}
