{
  "name": "myagentic-it-project-team-v2",
  "version": "0.4.0-rc.1",
  "description": "Agentic SDLC Platform - Multi-agent software development system",
  "main": "src/webapp/server.ts",
  "scripts": {
    "prepare": "husky",
    "start": "npm run plugin -- identity bootstrap && npm run plugin -- bootstrap --apply && tsx src/webapp/bootstrap.ts src/webapp/server.ts",
    "start:mcp": "tsx src/webapp/bootstrap.ts src/webapp/mcp-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:gate": "node scripts/check-coverage-thresholds.mjs",
    "test:prompt-snapshots": "vitest run tests/unit/prompt-template-snapshots.test.js",
    "test:mutation": "npx @stryker-mutator/core run",
    "test:perf-gate": "node scripts/perf-regression-gate.mjs",
    "test:integration": "vitest run tests/integration/",
    "test:smoke": "vitest run tests/smoke/",
    "test:chat-grounding": "vitest run tests/unit/chat-grounding-quality.test.js tests/unit/routes-chat.test.js tests/unit/rag-grounding-service.test.js",
    "test:chat-quality-gate": "vitest run tests/unit/chat-grounding-quality.test.js",
    "test:translations": "vitest run tests/unit/translation-validation.test.js",
    "test:a11y": "npx playwright test tests/e2e/s9h-accessibility.spec.ts --project=chromium",
    "test:autonomous-lane": "vitest run tests/integration/autonomous-lane.test.js --reporter=verbose",
    "tms:validate": "node scripts/weblate-sync.js validate",
    "tms:pull": "node scripts/weblate-sync.js pull",
    "tms:push": "node scripts/weblate-sync.js push",
    "lint": "eslint . --max-warnings=0 && npm run lint --prefix src/webapp/ui && npm run lint:ui:tokens",
    "lint:ui:tokens": "node scripts/check-ui-token-typography.mjs",
    "lint:fix": "eslint . --fix && npm run lint --prefix src/webapp/ui -- --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,jsx,tsx,json,md,yml,yaml}\"",
    "build": "npm run tokens:build && npm run build --prefix src/webapp/ui",
    "tokens:build": "node scripts/build-tokens.mjs",
    "plugin": "tsx src/webapp/plugins/mcp-governance/cli.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "audit:github": "node scripts/github-config-audit.js",
    "snapshot:github": "node scripts/github-state-snapshot.js",
    "generate:platform": "node scripts/generate-platform.js all",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "postinstall": "node scripts/generate-platform.js all"
  },
  "bin": {
    "my-plugin": "src/webapp/plugins/mcp-governance/cli.ts",
    "plugin": "src/webapp/plugins/mcp-governance/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RobertAgterhuis/myAgentic-IT-Project-team-V2.git"
  },
  "keywords": [
    "agentic",
    "sdlc",
    "multi-agent",
    "ai",
    "automation"
  ],
  "author": "Robert Agterhuis",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.3",
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lighthouse": "^12.6.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@lancedb/lancedb": "^0.27.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@octokit/rest": "^22.0.1",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "azure-devops-node-api": "^15.1.2",
    "better-sqlite3": "^12.8.0",
    "browserfs": "^1.4.3",
    "bullmq": "^5.71.0",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.0",
    "isomorphic-git": "^1.37.4",
    "markdown-it": "^14.1.1",
    "tsx": "^4.21.0",
    "yaml": "^2.8.2"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
