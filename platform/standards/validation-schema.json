{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myagentic-it-project-team-v2/platform/standards/validation-schema.json",
  "title": "Unified Handoff Template Schema",
  "description": "Canonical schema for handoff documents after markdown parsing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "deliverables", "handoff", "exitCriteriaMet"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "description"],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "status", "nextAction"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "BLOCKED", "ESCALATED"]
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exitCriteriaMet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checked", "text"],
        "properties": {
          "checked": {
            "type": "boolean"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "escalations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualityValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "evidence"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lessonsLearned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technicalDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "rationale"],
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string"
          }
        }
      }
    }
  }
}
