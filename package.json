{
  "name": "myagentic-it-project-team-v2",
  "version": "0.4.0-rc.1",
  "description": "Agentic SDLC Platform - Multi-agent software development system",
  "main": "src/webapp/server.js",
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "start": "node src/webapp/server.js",
    "start:mcp": "node src/webapp/mcp-server.js",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:integration": "jest --testMatch='**/*.integration.test.js' --passWithNoTests",
    "test:smoke": "jest --testMatch='**/*.smoke.test.js' --passWithNoTests",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:vitest:coverage": "vitest run --coverage",
    "test:all": "vitest run && jest --passWithNoTests",
    "test:translations": "jest tests/unit/translation-validation.test.js --passWithNoTests --verbose",
    "test:a11y": "echo 'Accessibility gate: start server then run npx @axe-core/cli http://127.0.0.1:3000 --tags wcag2a,wcag2aa --exit'",
    "tms:validate": "node scripts/weblate-sync.js validate",
    "tms:pull": "node scripts/weblate-sync.js pull",
    "tms:push": "node scripts/weblate-sync.js push",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.ts,.jsx,.tsx --fix",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,jsx,tsx,json,md,yml,yaml}\"",
    "build": "echo 'No build step required — server runs native Node.js'",
    "audit:github": "node scripts/github-config-audit.js",
    "snapshot:github": "node scripts/github-state-snapshot.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RobertAgterhuis/myAgentic-IT-Project-team-V2.git"
  },
  "keywords": [
    "agentic",
    "sdlc",
    "multi-agent",
    "ai",
    "automation"
  ],
  "author": "Robert Agterhuis",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "jsdom": "^28.1.0",
    "lighthouse": "^12.6.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/*.config.js",
      "!**/*.test.{js,ts}",
      "!**/*.spec.{js,ts}",
      "!.github/**"
    ],
    "testMatch": [
      "<rootDir>/tests/unit/email-templates.test.js",
      "<rootDir>/tests/unit/landing-experiment.test.js",
      "<rootDir>/tests/unit/landing-matomo.test.js",
      "<rootDir>/tests/unit/landing-qa.test.js",
      "<rootDir>/tests/unit/matomo-analytics.test.js",
      "<rootDir>/tests/unit/matomo-cors-fix.test.js",
      "<rootDir>/tests/unit/middleware.test.js",
      "<rootDir>/tests/unit/pilot-readiness.test.js",
      "<rootDir>/tests/unit/social-cards.test.js",
      "<rootDir>/tests/unit/translation-validation.test.js",
      "<rootDir>/tests/unit/weblate-docker.test.js",
      "<rootDir>/tests/unit/weblate-sync.test.js",
      "<rootDir>/tests/unit/weblate-trial.test.js",
      "<rootDir>/tests/integration/health.integration.test.js",
      "<rootDir>/tests/integration/server.integration.test.js",
      "<rootDir>/tests/integration/subscribe.integration.test.js",
      "<rootDir>/tests/smoke/landing.smoke.test.js",
      "<rootDir>/tests/example.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.github/"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  }
}
