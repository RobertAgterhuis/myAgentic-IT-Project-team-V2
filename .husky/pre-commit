# S2-6: Pre-commit hook — lint-staged + fast unit tests
# Guardrail: G-GLOB-60 (block direct commits to main)

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo ""
  echo "  ERROR: Direct commits to 'main' are BLOCKED."
  echo "  Create a feature branch first: git checkout -b sprint/SP-N/STORY-ID"
  echo ""
  exit 1
fi

# Guardrail: all decision-register changes must be included in commits.
UNSTAGED_DECISIONS=$(git diff --name-only -- BusinessDocs/decisions)
if [ -n "$UNSTAGED_DECISIONS" ]; then
  echo ""
  echo "  ERROR: Unstaged changes detected in BusinessDocs/decisions."
  echo "  Policy: everything under BusinessDocs/decisions must be committed together."
  echo ""
  echo "$UNSTAGED_DECISIONS"
  echo ""
  echo "  Stage them first: git add BusinessDocs/decisions"
  echo ""
  exit 1
fi

# Run lint-staged (ESLint + Prettier on staged files)
npx lint-staged

# TypeScript type check (warn only — CI also uses continue-on-error)
npx tsc --noEmit || echo "  WARNING: TypeScript type check found errors (non-blocking)"

# Run tests related to staged files (fast & targeted)
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.ts' '*.jsx' '*.tsx')
if [ -n "$STAGED" ]; then
  npx vitest related $STAGED --run --reporter=dot
fi
