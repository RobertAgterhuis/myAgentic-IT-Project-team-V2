# S2-6: Pre-commit hook — lint-staged + fast unit tests
# Guardrail: G-GLOB-60 (block direct commits to main)

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo ""
  echo "  ERROR: Direct commits to 'main' are BLOCKED."
  echo "  Create a feature branch first: git checkout -b sprint/SP-N/STORY-ID"
  echo ""
  exit 1
fi

# Run lint-staged (ESLint on staged files)
npx lint-staged

# Run fast unit tests (schemas + middleware — lightweight, <5s)
npx vitest run src/webapp/schemas.test.js src/webapp/middleware.test.js --reporter=dot
