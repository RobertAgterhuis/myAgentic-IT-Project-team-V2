# .env.example — Template for docker-compose.dev.yml
# Copy to .env and fill in the values before running:
#   docker compose -f infra/docker-compose.dev.yml up --build

# ── GitHub OAuth provider ──────────────────────────────────────────────────────
# Register an OAuth app at https://github.com/settings/developers.
# Authorization callback URL must be: <AUTH_CALLBACK_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Microsoft Entra ID (Azure AD) OIDC provider ───────────────────────────────
# Register an app in the Azure portal: https://portal.azure.com
# The provider is disabled when ENTRA_CLIENT_ID is not set — no startup crash.
#
# ENTRA_CLIENT_ID      — Application (client) ID of the app registration
# ENTRA_TENANT_ID      — Directory (tenant) ID; use "common" for multi-tenant
# ENTRA_CLIENT_SECRET  — Client secret created under "Certificates & secrets"
# ENTRA_REDIRECT_URI   — Callback URL registered in the app; must match exactly.
#                        Defaults to <AUTH_CALLBACK_URL>/api/auth/entra/callback
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# ── Auth / session settings ────────────────────────────────────────────────────
# AUTH_CALLBACK_URL    — Public base URL used to derive callback URLs.
#                        Example: https://myapp.example.com
# AUTH_STATE_SECRET    — HMAC secret for OAuth state signing (32+ random bytes).
#                        Auto-generated at startup when not set.
# AUTH_SECURE_COOKIES  — Set to "true" in production (requires HTTPS).
AUTH_CALLBACK_URL=http://localhost:3000
AUTH_STATE_SECRET=
AUTH_SECURE_COOKIES=false

# Matomo (Analytics) — required for matomo + matomo-db services
MATOMO_DB_PASSWORD=changeme
MATOMO_DB_ROOT_PASSWORD=changeme
MATOMO_PORT=8080

# Weblate passwords are in .env.weblate (see .env.weblate.example)
