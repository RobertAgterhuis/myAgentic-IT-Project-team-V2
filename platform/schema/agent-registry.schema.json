{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myagentic-it.local/schema/agent-registry.schema.json",
  "title": "Agent Registry Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "generatedAt", "stats", "agents"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalAgents", "agencyAgents", "sdlcAgents", "domains"],
      "properties": {
        "totalAgents": { "type": "integer", "minimum": 1 },
        "agencyAgents": { "type": "integer", "minimum": 0 },
        "sdlcAgents": { "type": "integer", "minimum": 0 },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/domain" },
          "uniqueItems": true
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agent" }
    }
  },
  "$defs": {
    "domain": {
      "type": "string",
      "enum": [
        "academic",
        "design",
        "engineering",
        "game-development",
        "integrations",
        "marketing",
        "paid-media",
        "product",
        "project-management",
        "sales",
        "spatial-computing",
        "specialized",
        "strategy",
        "support",
        "testing",
        "sdlc"
      ]
    },
    "timelineEstimate": {
      "type": "string",
      "enum": ["<4 hours", "4-8 hours", "1-3 days", "3-5 days", ">1 week"]
    },
    "phase": {
      "type": "string",
      "enum": [
        "SPRINT_GATE",
        "ONBOARDING",
        "PHASE_1",
        "PHASE_2",
        "PHASE_3",
        "PHASE_4",
        "CRITIC_RISK",
        "SYNTHESIS",
        "PHASE_5_EXECUTING",
        "REEVALUATE",
        "FEATURE",
        "QUESTIONNAIRE",
        "SCOPE_CHANGE",
        "ON_DEMAND"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "legacyId",
        "agentType",
        "name",
        "description",
        "domain",
        "color",
        "emoji",
        "vibe",
        "capabilities",
        "inputs",
        "outputs",
        "minPrerequisites",
        "optionalInputs",
        "skillPath",
        "requiredTools",
        "phase",
        "gatekeeper",
        "gateMembership",
        "sequenceDependencies",
        "maxRetries",
        "timelineEstimate",
        "successRate",
        "avgQualityScore",
        "commonFailures",
        "worksWith",
        "conflictsWith",
        "successPatterns",
        "lastUpdated",
        "sourceFiles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(agency|sdlc)-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "legacyId": {
          "type": ["string", "null"]
        },
        "agentType": {
          "type": "string",
          "enum": ["agency", "sdlc"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/domain" },
          "uniqueItems": true
        },
        "color": {
          "type": ["string", "null"]
        },
        "emoji": {
          "type": ["string", "null"]
        },
        "vibe": {
          "type": ["string", "null"]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "minPrerequisites": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optionalInputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "skillPath": {
          "type": "string",
          "minLength": 1
        },
        "requiredTools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "phase": {
          "anyOf": [{ "$ref": "#/$defs/phase" }, { "type": "null" }]
        },
        "gatekeeper": {
          "type": "boolean"
        },
        "gateMembership": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sequenceDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(agency|sdlc)-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "timelineEstimate": { "$ref": "#/$defs/timelineEstimate" },
        "successRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "avgQualityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "commonFailures": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "worksWith": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(agency|sdlc)-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "conflictsWith": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(agency|sdlc)-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "successPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
