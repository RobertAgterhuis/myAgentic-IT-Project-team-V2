{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myagentic-it.local/schema/tool-canonical.schema.json",
  "title": "Canonical Tool Contract Schema",
  "description": "Platform-neutral schema for abstract tool definitions with capability flags and parameter schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "generatedAt", "tools"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/toolDefinition" }
    }
  },
  "$defs": {
    "toolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "category",
        "capabilities",
        "parameters",
        "returnType",
        "sideEffects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tool\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "file-system",
            "context",
            "validation",
            "session",
            "github",
            "orchestration",
            "testing",
            "synthesis"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readOnly", "supportsBackground", "supportsTimeout"],
          "properties": {
            "readOnly": { "type": "boolean" },
            "supportsBackground": { "type": "boolean" },
            "supportsTimeout": { "type": "boolean" }
          }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterDefinition" }
        },
        "returnType": {
          "type": "string",
          "minLength": 1
        },
        "sideEffects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "platformBindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "copilot": { "$ref": "#/$defs/toolPlatformBinding" },
            "claude": { "$ref": "#/$defs/toolPlatformBinding" },
            "openai": { "$ref": "#/$defs/toolPlatformBinding" }
          }
        }
      }
    },
    "parameterDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["string", "number", "boolean", "object", "array"] },
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "toolPlatformBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nativeName"],
      "properties": {
        "nativeName": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
